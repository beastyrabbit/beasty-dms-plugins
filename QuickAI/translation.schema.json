{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "translation": { "type": "string" },
    "sourceLanguage": { "enum": ["en", "de", "ambiguous", "unknown"] },
    "targetLanguage": { "enum": ["en", "de"] },
    "alternatives": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "translation": { "type": "string" },
          "nuance": { "type": "string" }
        },
        "required": ["translation", "nuance"],
        "additionalProperties": false
      }
    },
    "grammar": { "type": "string" },
    "usage": { "type": "string" },
    "ambiguityNote": { "type": "string" },
    "ambiguous": { "type": "boolean" }
  },
  "required": [
    "translation",
    "sourceLanguage",
    "targetLanguage",
    "alternatives",
    "grammar",
    "usage",
    "ambiguityNote",
    "ambiguous"
  ],
  "additionalProperties": false
}
